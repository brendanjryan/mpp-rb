    # pkg:gem/stripe#lib/stripe/util.rb:312
    def normalize_opts(opts); end

    # pkg:gem/stripe#lib/stripe/util.rb:28
    def object_classes; end

    # @return [Boolean]
    #
    # pkg:gem/stripe#lib/stripe/util.rb:44
    def object_name_matches_class?(object_name, klass); end

    # pkg:gem/stripe#lib/stripe/util.rb:7
    def objects_to_ids(obj, serialize_empty: T.unsafe(nil)); end

    # Generates a Dashboard link to inspect a request ID based off of a request

  def http_body; end

  # The raw HTTP body of the response.
  #
  # pkg:gem/stripe#lib/stripe/stripe_response.rb:75
  def http_body=(_arg0); end

  class << self
    # Initializes a StripeResponse object from a Net::HTTP::HTTPResponse
    # object.

  # pkg:gem/stripe#lib/stripe/resources/identity/verification_report.rb:354
  sig { returns(T.nilable(String)) }
  def client_reference_id; end

  # Time at which the object was created. Measured in seconds since the Unix epoch.
  #
  # pkg:gem/stripe#lib/stripe/resources/identity/verification_report.rb:356
  sig { returns(Integer) }
  def created; end

  # Result from a document check
  #
  # pkg:gem/stripe#lib/stripe/resources/identity/verification_report.rb:358
  sig { returns(T.nilable(Document)) }
  def document; end

  # Result from a email check
  #
  # pkg:gem/stripe#lib/stripe/resources/identity/verification_report.rb:360
  sig { returns(T.nilable(Email)) }
  def email; end

  # Unique identifier for the object.
  #
  # pkg:gem/stripe#lib/stripe/resources/identity/verification_report.rb:362
  sig { returns(String) }
  def id; end

  # Result from an id_number check
  #
  # pkg:gem/stripe#lib/stripe/resources/identity/verification_report.rb:364
  sig { returns(T.nilable(IdNumber)) }
  def id_number; end

  # If the object exists in live mode, the value is `true`. If the object exists in test mode, the value is `false`.
  #
  # pkg:gem/stripe#lib/stripe/resources/identity/verification_report.rb:366
  sig { returns(T::Boolean) }
  def livemode; end

  # String representing the object's type. Objects of the same type share the same value.
  #
  # pkg:gem/stripe#lib/stripe/resources/identity/verification_report.rb:368
  sig { returns(String) }
  def object; end

  # Attribute for field options
  #
  # pkg:gem/stripe#lib/stripe/resources/identity/verification_report.rb:370
  sig { returns(T.nilable(Options)) }
  def options; end

  # Result from a phone check
  #
  # pkg:gem/stripe#lib/stripe/resources/identity/verification_report.rb:372
  sig { returns(T.nilable(Phone)) }
  def phone; end

  # Result from a selfie check
  #
  # pkg:gem/stripe#lib/stripe/resources/identity/verification_report.rb:374
  sig { returns(T.nilable(Selfie)) }
  def selfie; end

  # Type of report.
  #
  # pkg:gem/stripe#lib/stripe/resources/identity/verification_report.rb:376
  sig { returns(String) }
  def type; end

  # The configuration token of a verification flow from the dashboard.
  #
  # pkg:gem/stripe#lib/stripe/resources/identity/verification_report.rb:378

# pkg:gem/stripe#lib/stripe/services/invoice_line_item_service.rb:5
class Stripe::InvoiceLineItemService < ::Stripe::StripeService
  # When retrieving an invoice, you'll get a lines property containing the total count of line items and the first handful of those items. There is also a URL where you can retrieve the full (paginated) list of line items.
  #
  # pkg:gem/stripe#lib/stripe/services/invoice_line_item_service.rb:7
  sig do
    params(
      invoice: String,
      params: T.any(::Stripe::InvoiceLineItemListParams, T::Hash[T.untyped, T.untyped]),
      opts: T.untyped
    ).returns(::Stripe::ListObject)
  end
  def list(invoice, params = T.unsafe(nil), opts = T.unsafe(nil)); end

  # Updates an invoice's line item. Some fields, such as tax_amounts, only live on the invoice line item,
  # so they can only be updated through this endpoint. Other fields, such as amount, live on both the invoice
  # item and the invoice line item, so updates on this endpoint will propagate to the invoice item as well.
  # Updating an invoice's line item is only possible before the invoice is finalized.
  #
  # pkg:gem/stripe#lib/stripe/services/invoice_line_item_service.rb:21
  # Updates an invoice's line item. Some fields, such as tax_amounts, only live on the invoice line item,
  # so they can only be updated through this endpoint. Other fields, such as amount, live on both the invoice
  # item and the invoice line item, so updates on this endpoint will propagate to the invoice item as well.
  sig do
    params(
      invoice: String,
      line_item_id: String,
      params: T.any(::Stripe::InvoiceLineItemUpdateParams, T::Hash[T.untyped, T.untyped]),
      opts: T.untyped
    ).returns(::Stripe::InvoiceLineItem)
  end
  def update(invoice, line_item_id, params = T.unsafe(nil), opts = T.unsafe(nil)); end
end


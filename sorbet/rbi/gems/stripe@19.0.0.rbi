# pkg:gem/stripe#lib/stripe/services/coupon_service.rb:5
class Stripe::CouponService < ::Stripe::StripeService
  # You can create coupons easily via the [coupon management](https://dashboard.stripe.com/coupons) page of the Stripe dashboard. Coupon creation is also accessible via the API if you need to create coupons on the fly.
  #
  # A coupon has either a percent_off or an amount_off and currency. If you set an amount_off, that amount will be subtracted from any invoice's subtotal. For example, an invoice with a subtotal of 100 will have a final total of 0 if a coupon with an amount_off of 200 is applied to it and an invoice with a subtotal of 300 will have a final total of 100 if a coupon with an amount_off of 200 is applied to it.
  #
  # pkg:gem/stripe#lib/stripe/services/coupon_service.rb:9
  # You can create coupons easily via the [coupon management](https://dashboard.stripe.com/coupons) page of the Stripe dashboard. Coupon creation is also accessible via the API if you need to create coupons on the fly.
  sig do
    params(
      params: T.any(::Stripe::CouponCreateParams, T::Hash[T.untyped, T.untyped]),
      opts: T.untyped
    ).returns(::Stripe::Coupon)
  end
  def create(params = T.unsafe(nil), opts = T.unsafe(nil)); end

  # You can delete coupons via the [coupon management](https://dashboard.stripe.com/coupons) page of the Stripe dashboard. However, deleting a coupon does not affect any customers who have already applied the coupon; it means that new customers can't redeem the coupon. You can also delete coupons via the API.
  #
  # pkg:gem/stripe#lib/stripe/services/coupon_service.rb:14
  sig do
    params(
      coupon: String,
      params: T.any(::Stripe::CouponDeleteParams, T::Hash[T.untyped, T.untyped]),
      opts: T.untyped
    ).returns(::Stripe::Coupon)
  end
  def delete(coupon, params = T.unsafe(nil), opts = T.unsafe(nil)); end

  # Returns a list of your coupons.
  #
  # pkg:gem/stripe#lib/stripe/services/coupon_service.rb:25
  sig do
    params(
      params: T.any(::Stripe::CouponListParams, T::Hash[T.untyped, T.untyped]),
      opts: T.untyped
    ).returns(::Stripe::ListObject)
  end
  def list(params = T.unsafe(nil), opts = T.unsafe(nil)); end

  # Retrieves the coupon with the given ID.
  #
  # pkg:gem/stripe#lib/stripe/services/coupon_service.rb:30
  sig do
    params(
      coupon: String,
      params: T.any(::Stripe::CouponRetrieveParams, T::Hash[T.untyped, T.untyped]),
      opts: T.untyped
    ).returns(::Stripe::Coupon)
  end
  def retrieve(coupon, params = T.unsafe(nil), opts = T.unsafe(nil)); end

  # Updates the metadata of a coupon. Other coupon details (currency, duration, amount_off) are, by design, not editable.
  #
  # pkg:gem/stripe#lib/stripe/services/coupon_service.rb:41
  sig do
    params(
      coupon: String,
      params: T.any(::Stripe::CouponUpdateParams, T::Hash[T.untyped, T.untyped]),
      opts: T.untyped
    ).returns(::Stripe::Coupon)
  end
  def update(coupon, params = T.unsafe(nil), opts = T.unsafe(nil)); end
end

